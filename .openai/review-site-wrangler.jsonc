{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ghost-cart-review-proxy",
  "main": "../dist/server/index.js",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "../dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ghostcart-v2-db",
      "database_id": "325c0966-2b01-4a60-97a9-1a6d974d8039"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT_MEDIA",
      "bucket_name": "ghostcart-content-media"
    }
  ],
  "routes": [
    {
      "pattern": "test.theghostcart.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
