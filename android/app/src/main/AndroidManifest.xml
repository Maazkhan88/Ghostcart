<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Not on the Play Store yet - in-app updates download an APK directly
         and launch the system installer, which needs this to work at all
         on API 26+. The user still gets the standard one-time "allow Ghost
         Cart to install unknown apps" system prompt; this permission alone
         does not bypass it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Ghost Cart doesn't show ads yet, but the user has confirmed ads are planned for a
         future release - kept in (not removed via tools:node="remove") so that decision
         doesn't require another manifest change + rebuild + re-declaration cycle later.
         The Play Console "Advertising ID" declaration should be answered "Yes" to match. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.GhostCart">
        <!--
          singleTask (was singleTop): MainActivity is the app's only Activity, so clear-top
          semantics have nothing else to wipe. singleTop only dedupes when this Activity is
          already the top of its OWN task's back stack; it does not guarantee the existing
          Ghost Cart task is reused when launched via ACTION_SEND from another app's task
          (e.g. Amazon's share sheet), which is the documented cause of a second app
          instance/task appearing instead of onNewIntent() firing on the running instance.
          singleTask instead guarantees the system finds/reuses the existing task across
          launcher, share, deep-link, and notification-tap entry points. See Phase 1 plan
          notes for the required 7-path device verification (launcher, single share,
          sequential shares, deep link, notification tap, Recents, back-navigation).
        -->
        <activity
            android:name="com.example.ghostcart.MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="theghostcart.com"
                    android:pathPrefix="/ghost" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="theghostcart.com"
                    android:pathPrefix="/gift" />
            </intent-filter>
            <!-- theghostcart.com/app/... - in-app deep links (currently just
                 /app/cooldown/{id} from the cooldown-resolved email's "Open
                 Ghost Cart" button; see MainActivity.captureCooldownDeepLink).
                 Separate intent-filter from /ghost above since they serve
                 different purposes (a shared item vs the signed-in user's own
                 content) and may grow independently. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="theghostcart.com"
                    android:pathPrefix="/app" />
            </intent-filter>
        </activity>

        <service
            android:name="com.example.ghostcart.data.GhostFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Handles the "I skipped it"/"Bought it"/"More time" action buttons on a
             cooling-complete notification, without needing to open the app. Not
             exported: only reachable via the PendingIntents this app itself creates. -->
        <receiver
            android:name="com.example.ghostcart.data.CooldownNotificationActionReceiver"
            android:exported="false" />
    </application>

</manifest>
