<?xml version="1.0" encoding="utf-8"?>
<!-- Firebase's startup ContentProvider reads these google-services-generated
     strings by raw resource name, not a compile-time R.string reference, so
     shrinkResources can't see the usage and strips them without this. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/google_app_id,@string/google_api_key,@string/google_crash_reporting_api_key,@string/gcm_defaultSenderId,@string/google_storage_bucket,@string/project_id" />
